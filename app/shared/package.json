{
  "name": "synth.kitchen-shared",
  "version": "0.5.13",
  "description": "shared types and utils for synth.kitchen-api and synth.kitchen-web",
  "license": "MIT",
  "keywords": [],
  "type": "commonjs",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    "import": "./build/index.js",
    "require": "./build/index.js"
  },
  "scripts": {
    "dev": "concurrently -k -n tsc,build 'npm run lint' 'npx tsx --watch src/index.ts'",
    "build": "tsc -p tsconfig.build.json && node -r ts-node/register build.ts",
    "lint": "tsc --preserveWatchOutput --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "server-name-gen": "file:../../submodules/server-name-gen",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "9.2.5",
    "esbuild": "0.27.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "standardized-audio-context": "25.3.77"
  }
}
