{
   "compilerOptions": {
      "target": "es2022",
      "lib": [
         "es2022"
      ],
      "outDir": "./build/",
      "module": "Node16",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "experimentalDecorators": true,
      "skipLibCheck": true,
      "moduleResolution": "node16",
      "emitDecoratorMetadata": true,
      "strict": false,
      "types": ["node"]
   }
}